# Local development configuration for the active Zorix API.
# Copy to .env and replace SECRET_KEY before starting the API.
DATABASE_TYPE=sqlite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zorix
POSTGRES_USER=zorix_user
POSTGRES_PASSWORD=change-this-password

SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Optional: token for private repositories or higher GitHub API limits.
GITHUB_TOKEN=
SEMGREP_PATH=semgrep
REPORTS_DIR=./reports
LOGS_DIR=./logs
